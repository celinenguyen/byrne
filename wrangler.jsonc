{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "byrne",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets (dist/client, including public/images) are served before the
  // Worker runs; everything else, including /api/* and uploaded images, goes
  // through the Astro app.
  "observability": { "enabled": true },

  // Cloudflare creates the DNS record for a custom domain itself; the zone only
  // has to be on Cloudflare nameservers.
  "workers_dev": true,
  "routes": [{ "pattern": "decks.celinenguyen.com", "custom_domain": true }],

  // Deck JSON and uploaded images. Layout is documented in src/lib/storage/r2.ts.
  "r2_buckets": [{ "binding": "DECKS", "bucket_name": "byrne-decks" }]

  // Secrets (set with `wrangler secret put`, never committed):
  //   GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, SESSION_SECRET
  // See .env.example.
}
