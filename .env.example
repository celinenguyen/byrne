# Copy to `.env` for local use, and set the same values in the Vercel project
# settings for production. `.env` is gitignored.
#
# None of these are needed for `npm run dev` — local development bypasses auth
# and writes straight to `data/` on disk (see src/middleware.ts).

# --- GitHub OAuth (identity only) ---
# From https://github.com/settings/developers → New OAuth App.
#   Homepage URL:               https://byrne.vercel.app
#   Authorization callback URL: https://byrne.vercel.app/api/auth/callback
# This app requests `read:user` and nothing more — it proves who you are, it
# does not write anything.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Session signing ---
# Any long random string. Generate one with:
#   node -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
# Rotating this invalidates every existing session.
SESSION_SECRET=

# --- Who can edit ---
# Optional. Defaults to 1417844 (@celinenguyen) — see src/lib/auth.ts for why
# this is a numeric id rather than a username. Find another account's id with:
#   curl https://api.github.com/users/<login>
ALLOWED_GITHUB_USER_ID=

# --- Deck storage (production) ---
# Deck JSON is committed to the repo through the GitHub Contents API, so the
# deployed editor and your local checkout share one source of truth.
#
# GITHUB_REPO_TOKEN is deliberately NOT named GITHUB_TOKEN: the `gh` CLI reads
# that name from the shell environment, so reusing it would let a stale shell
# token silently override this one during local development.
#
# Create at https://github.com/settings/tokens?type=beta
#   Repository access: only this repository
#   Permissions:       Contents → Read and write
GITHUB_REPO_TOKEN=
GITHUB_REPO=celinenguyen/byrne

# Optional. Branch that decks are committed to. Defaults to main.
GITHUB_BRANCH=

# Optional. Force a storage backend: `fs` (local files) or `github`.
# Defaults to fs during `npm run dev` and github everywhere else. Mainly useful
# for exercising the GitHub backend locally against a scratch branch.
DECK_STORAGE=
